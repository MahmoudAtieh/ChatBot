# HTTP server
PORT=3000
NODE_ENV=development

# Extracted, reviewed data package included in this repository.
DATA_PROCESSING_DIR=./Data-Processing

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional stable identifier that improves prompt-cache routing.
OPENAI_PROMPT_CACHE_KEY=arabic-sofa-assistant-v1

# Shopify Admin GraphQL API (read-only app scope: read_products)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Set this to the active Graph API version used by your Meta app, for example vXX.X.
META_GRAPH_API_VERSION=

# PostgreSQL. If omitted, development uses an in-memory repository.
DATABASE_URL=
# Random secret used to create non-reversible conversation identifiers.
CONVERSATION_HASH_SECRET=

# Durable inbound queue encryption. Required whenever DATABASE_URL is set.
# Format: key-id:32-byte-base64url-key. Keep old keys here while rotating.
QUEUE_ENCRYPTION_KEYS=
QUEUE_ENCRYPTION_ACTIVE_KEY_ID=

# Durable worker tuning. Keep WORKER_LEASE_MS at 180000 or higher.
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=8
WORKER_LEASE_MS=300000
WORKER_MAX_ATTEMPTS=6
WORKER_RETRY_BASE_MS=5000
WORKER_RETRY_MAX_MS=300000

# Local-only testing route. Keep false in production.
ENABLE_TEST_CHAT=true
